# ==========================================
# OPĆA KONFIGURACIJA APLIKACIJE
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# RAVENDB KONFIGURACIJA
# ==========================================
RAVENDB_URL=http://127.0.0.1:8080
RAVENDB_DATABASE=your_raven_database_name
# Ukoliko RavenDB server zahtijeva sertifikat (HTTPS/secure mode), popuniti putanju:
RAVENDB_CERT_PATH=

# ==========================================
# ORIENTDB KONFIGURACIJA
# ==========================================
ORIENTDB_HOST=127.0.0.1
ORIENTDB_PORT=2424
ORIENTDB_USERNAME=your_orientdb_username
ORIENTDB_PASSWORD=your_orientdb_password
ORIENTDB_DATABASE=your_orient_database_name
ORIENTDB_DB_USERNAME=your_orientdb_username
ORIENTDB_DB_PASSWORD=your_orientdb_password

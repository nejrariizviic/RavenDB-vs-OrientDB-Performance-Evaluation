# ==========================================
# OPĆA KONFIGURACIJA APLIKACIJE
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# RAVENDB KONFIGURACIJA
# ==========================================
RAVENDB_URL=http://127.0.0.1:8080
RAVENDB_DATABASE=MovieLensDB_Raven
# Ukoliko RavenDB server zahtijeva sertifikat (HTTPS/secure mode), popuniti putanju:
RAVENDB_CERT_PATH=

# ==========================================
# ORIENTDB KONFIGURACIJA
# ==========================================
ORIENTDB_HOST=127.0.0.1
ORIENTDB_PORT=2424
ORIENTDB_USERNAME=root
ORIENTDB_PASSWORD=admin
ORIENTDB_DATABASE=MovieLensDB_Orient
ORIENTDB_DB_USERNAME=root
ORIENTDB_DB_PASSWORD=admin
